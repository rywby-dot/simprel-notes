<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
 <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_preview_bg" android:importantForAccessibility="no"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
  <ImageView android:id="@+id/widget_text_action" android:visibility="gone" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:padding="16dp" android:scaleType="centerInside" android:background="@drawable/widget_touch" android:src="@drawable/ic_new_note" android:contentDescription="@string/new_note"/>
  <ImageView android:id="@+id/widget_voice_action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:padding="16dp" android:scaleType="centerInside" android:background="@drawable/widget_touch" android:src="@drawable/ic_shortcut_voice" android:contentDescription="@string/new_voice_note"/>
 </LinearLayout>
</FrameLayout>