<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
 <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_preview_bg" android:importantForAccessibility="no"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp" android:orientation="vertical">
  <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="@string/widget_last_note" android:textSize="12sp" android:textColor="@color/widget_ink" android:maxLines="2" android:ellipsize="end"/>
  <ImageView android:id="@+id/widget_audio" android:layout_width="match_parent" android:layout_height="32dp" android:scaleType="fitStart" android:contentDescription="@string/voice_note" android:visibility="gone"/>
  <TextView android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:layout_marginBottom="30dp" android:text="@string/empty_notes" android:textSize="14sp" android:textColor="@color/widget_ink" android:ellipsize="end"/>
 </LinearLayout>
 <ImageView android:id="@+id/widget_count_bg" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="bottom|end" android:layout_margin="12dp" android:importantForAccessibility="no" android:visibility="gone"/>
 <TextView android:id="@+id/widget_count" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="bottom|end" android:layout_margin="12dp" android:gravity="center" android:textSize="12sp" android:visibility="gone"/>
</FrameLayout>